# ==============================================================================
# own-calendar server — example environment
# Copy to .env and fill in values. NEVER commit the actual .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# Tailscale sidecar
# ------------------------------------------------------------------------------
# admin.tailscale.com > Settings > Keys > Generate auth key
#   - Reusable: ON
#   - Ephemeral: OFF
#   - Tags: tag:funnel   (ACL must allow `funnel` nodeAttr on this tag)
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Database (PostgreSQL in sidecar network)
# ------------------------------------------------------------------------------
# Strong random password, min 24 chars. Example:
#   openssl rand -base64 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Directory on the host where Postgres data is persisted (bind-mounted).
# Default: $HOME/own-calendar-data
# OWN_CALENDAR_DATA=/absolute/path/to/own-calendar-data

# ------------------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------------------
# Strong random secret, min 64 chars. Example:
#   openssl rand -hex 48
JWT_SECRET=change-me-to-a-64-character-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Google OAuth (Calendar sync)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://own-calendar.tailb2886a.ts.net/api/google/callback

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed Origins for browser clients (Flutter Web).
# Leave empty to disable CORS entirely (native mobile apps don't need it).
# Example: CORS_ORIGIN=https://own-calendar.tailb2886a.ts.net
CORS_ORIGIN=

# ------------------------------------------------------------------------------
# Cloud Database (optional — for migration from local PostgreSQL)
# ------------------------------------------------------------------------------
# Uncomment and set ONE of these to migrate to a cloud DB provider.
# After migration, update DATABASE_URL in docker-compose.yml as well.
#
# Supabase:
# CLOUD_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Neon:
# CLOUD_DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
#
# Railway:
# CLOUD_DATABASE_URL=postgresql://postgres:[password]@[host].railway.app:5432/railway

# ------------------------------------------------------------------------------
# Backup — S3-compatible storage (optional)
# ------------------------------------------------------------------------------
# Set these to enable automatic backup upload to S3-compatible storage.
# Works with AWS S3, Cloudflare R2, MinIO, Backblaze B2, etc.
#
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BACKUP_S3_BUCKET=my-backup-bucket
# BACKUP_S3_PREFIX=own-calendar-backups
# BACKUP_S3_ENDPOINT=                  # For non-AWS S3: https://xxx.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
