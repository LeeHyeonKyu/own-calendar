generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  name                String
  passwordHash        String
  calendars           Calendar[]
  events              Event[]            @relation("CreatedEvents")
  tasks               Task[]             @relation("CreatedTasks")
  refreshTokens       RefreshToken[]
  familyMemberships   FamilyMembership[]
  createdFamilyGroups FamilyGroup[]      @relation("CreatedFamilyGroups")
  createdGroups       Group[]            @relation("CreatedGroups")
  groupMemberships    GroupMembership[]
  externalConnections ExternalCalendarConnection[]
  defaultReminderMinutes Int            @default(10)
  deviceTokens        DeviceToken[]
  sentFollows         Follow[]           @relation("FollowSent")
  receivedFollows     Follow[]           @relation("FollowReceived")
  eventInvites        EventInvite[]
  categories          Category[]
  holidaySubscriptions HolidaySubscription[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum CalendarVisibility {
  PUBLIC
  PRIVATE
}

enum CalendarType {
  PERSONAL
  FAMILY
  EXTERNAL
}

model Calendar {
  id            String             @id @default(cuid())
  name          String
  color         String             @default("#4A90D9")
  isDefault     Boolean            @default(false)
  visibility    CalendarVisibility @default(PUBLIC)
  type          CalendarType       @default(PERSONAL)
  ownerId       String
  owner         User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  familyGroupId String?            @unique
  familyGroup   FamilyGroup?       @relation(fields: [familyGroupId], references: [id])
  groupId       String?            @unique
  group         Group?             @relation(fields: [groupId], references: [id])
  events        Event[]
  tasks         Task[]
  externalConnection ExternalCalendarConnection?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Event {
  id          String        @id @default(cuid())
  externalId  String?
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  isAllDay    Boolean       @default(false)
  isPrivate   Boolean       @default(false)
  category       EventCategory  @default(PERSONAL)
  tags           String[]       @default([])
  recurrenceType RecurrenceType @default(NONE)
  recurrenceEnd  DateTime?
  location       String?
  notes          String?
  attendees      Json?
  reminderMinutes Int?
  rrule          String?
  categoryId     String?
  categoryRef    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  calendarId     String
  calendar    Calendar      @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User          @relation("CreatedEvents", fields: [createdById], references: [id])
  tasks       Task[]
  exceptions  RecurrenceException[] @relation("EventExceptions")
  invites     EventInvite[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum EventCategory {
  WORK
  PERSONAL
  FAMILY
  HEALTH
  SOCIAL
  FINANCE
  OTHER
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum FamilyRole {
  OWNER
  MEMBER
}

model FamilyGroup {
  id          String             @id @default(cuid())
  name        String
  code        String             @unique
  type        String             @default("가족")
  createdById String
  createdBy   User               @relation("CreatedFamilyGroups", fields: [createdById], references: [id])
  members     FamilyMembership[]
  calendar    Calendar?          @relation()
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model FamilyMembership {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyGroupId String
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  role          FamilyRole  @default(MEMBER)
  joinedAt      DateTime    @default(now())

  @@unique([userId, familyGroupId])
}

model ExternalCalendarConnection {
  id           String   @id @default(cuid())
  provider     String   @default("google")
  externalId   String
  accessToken  String
  refreshToken String
  tokenExpiry  DateTime?
  syncToken    String?
  calendarId   String   @unique
  calendar     Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSyncedAt        DateTime?
  syncStatus          String    @default("ok")
  lastSyncError       String?
  consecutiveFailures Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([provider, externalId, userId])
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

model DeviceToken {
  id        String         @id @default(cuid())
  token     String         @unique
  platform  DevicePlatform
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
}

enum TaskStatus {
  TODO
  DONE
  CANCELLED
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
  NONE
}

model Task {
  id             String         @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus     @default(TODO)
  priority       TaskPriority   @default(NONE)
  dueDate        DateTime?
  scheduledDate  DateTime?
  scheduledTime  String?
  recurrenceType RecurrenceType @default(NONE)
  recurrenceEnd  DateTime?
  rrule          String?
  completedAt    DateTime?
  location       String?
  notes          String?
  attendees      Json?
  checklist      Json?
  metaInherited  Boolean        @default(false)
  isHabit        Boolean        @default(false)
  categoryId     String?
  categoryRef    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  eventId        String?
  event          Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  calendarId     String
  calendar       Calendar       @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User           @relation("CreatedTasks", fields: [createdById], references: [id])
  sortOrder      Int            @default(0)
  exceptions     RecurrenceException[] @relation("TaskExceptions")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([calendarId])
  @@index([eventId])
  @@index([status])
  @@index([dueDate])
  @@index([isHabit])
}

model RecurrenceException {
  id             String    @id @default(cuid())
  masterEventId  String?
  masterEvent    Event?    @relation("EventExceptions", fields: [masterEventId], references: [id], onDelete: Cascade)
  masterTaskId   String?
  masterTask     Task?     @relation("TaskExceptions", fields: [masterTaskId], references: [id], onDelete: Cascade)
  originalDate   DateTime
  isDeleted      Boolean   @default(false)
  title          String?
  description    String?
  startTime      DateTime?
  endTime        DateTime?
  isAllDay       Boolean?
  status         TaskStatus?
  completedAt    DateTime?
  checklist      Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([masterEventId, originalDate])
  @@unique([masterTaskId, originalDate])
  @@index([masterEventId])
  @@index([masterTaskId])
}

enum FollowStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Follow {
  id          String       @id @default(cuid())
  followerId  String
  follower    User         @relation("FollowSent", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId  String
  followee    User         @relation("FollowReceived", fields: [followeeId], references: [id], onDelete: Cascade)
  status      FollowStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@unique([followerId, followeeId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model EventInvite {
  id        String       @id @default(cuid())
  eventId   String
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User         @relation(fields: [inviteeId], references: [id], onDelete: Cascade)
  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@unique([eventId, inviteeId])
}

enum GroupRole {
  OWNER
  MEMBER
}

model Group {
  id          String            @id @default(cuid())
  name        String
  code        String            @unique
  type        String            @default("가족")
  createdById String
  createdBy   User              @relation("CreatedGroups", fields: [createdById], references: [id])
  members     GroupMembership[]
  calendar    Calendar?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model GroupMembership {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([userId, groupId])
}

model Category {
  id        String  @id @default(cuid())
  name      String
  color     String
  emoji     String?
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    Event[]
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HolidaySubscription {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryCode String
  createdAt   DateTime @default(now())

  @@unique([userId, countryCode])
}

model Holiday {
  id          String   @id @default(cuid())
  countryCode String
  date        DateTime
  name        String
  year        Int
  createdAt   DateTime @default(now())

  @@unique([countryCode, date])
  @@index([countryCode, year])
}
